# =============================================================================
# Abdulmajeedpharma (APH) — Root .gitignore
# =============================================================================

# --- Environment and credentials (never commit real secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
credentials.json
service-account.json
*.key
*.pem
*.p12
*.jks
secrets/
secret/

# --- Flutter / Dart build outputs and caches ---
.mobile-to-flutter-build/           # placeholder, ignore if present
.mobile/
.build/
.android/
.ios/
macos/
linux/
windows/
web/
.dart_tool/
flutter_dart_build_info.json
.dart_tool/package_config.json
*.dart_tool/
.imagemagick/
.androidbuilder/

# Android signing keys (never commit)
**/android/app/*.jks
**/android/app/*.keystore
**/android/app/key.properties
**/android/app/upload-keystore.jks
**/android/key.properties
**/google-services.json
**/GoogleService-Info.plist

# iOS
**/ios/*.p12
**/ios/*.mobileprovision
**/ios/Runner/*.entitlements
**/ios/Runner/GoogleService-Info.plist

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
venv*/env/
.venv/
env/
ENV/
env.bin/
.venv/
pip-log.txt
pip-delete-this-directory.sha
.pyenv/
.python-version
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.coverage.*
*.mo

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-store/
.turbo/
.next/
out/
build/
dist/

# --- IDE and editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.settings/
.classpath

# --- Databases (local) ---
*.db
*.sqlite
*.sqlite3
# Ignore local .sql dumps but NOT versioned migrations/seeds
*.sql
!database/migrations/*.sql
!database/seeds/*.sql
local-db/
data/*.db

# --- Temporary uploads ---
uploads/
tmp/
temp/
*.tmp
*.upload
data-import/images/**/*.jpg
data-import/images/**/*.jpeg
data-import/images/**/*.png

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- End =====================================================================
