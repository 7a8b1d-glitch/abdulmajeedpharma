# =============================================================================
# Abdulmajeedpharma (APH) — Environment Example
# Copy this file to .env and replace the placeholder values.
# NEVER commit real credentials to version control.
# =============================================================================

# --- Application ---
APP_NAME=Abdulmajeedpharma
APP_SHORT_NAME=APH
APP_ENV=development
APP_DEBUG=true

# --- Database URL (PostgreSQL cloud) ---
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://aph_user:CHANGE_ME@aph-db.xxx.supabase.co:5432/aph_db

# --- Supabase (Auth + Storage) ---
SUPABASE_URL=https://aph-project.supabase.co
SUPABASE_PUBLIC_KEY=eyJ...PLACEHOLDER_PUBLIC_ANON_KEY
SUPABASE_SERVICE_KEY=eyJ...PLACEHOLDER_SERVICE_ROLE_KEY

# --- Redis (caching / synchronization) ---
REDIS_URL=redis://aph-redis.xxx.supabase.co:6379

# --- AI provider (RAG / Pharma AI) ---
AI_PROVIDER=google_vertex_ai   # or: openai, azure_openai, local
AI_API_KEY=sk-CHANGE_ME_AI_API_KEY

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=aph-project-xxxx
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Search service ---
SEARCH_SERVICE_URL=https://search.xxx.svc.cluster.local
SEARCH_API_KEY=CHANGE_ME_SEARCH_KEY

# --- JWT (access tokens) ---
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Support contact ---
SUPPORT_EMAIL=support@abdulmajeedpharma.example
SUPPORT_PHONE=+967-xxx-xxx-xxxx

# --- Flutter (mobile) ---
FLUTTER_SUPABASE_URL=https://aph-project.supabase.co
FLUTTER_SUPABASE_ANON_KEY=eyJ...PLACEHOLDER_PUBLIC_ANON_KEY

# =============================================================================
# SECURITY NOTICE:
# - Never insert real credentials here. This file contains placeholders only.
# - Never expose Supabase service-role keys in Flutter or browser (admin) code.
#   Service-role keys must only be used in trusted backend/server environments.
# =============================================================================
